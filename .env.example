# Copy to .env in the checkout root. Never commit real credentials.
MAC_BENCH_LLM_BASE_URL=https://api.openai.com/v1
MAC_BENCH_LLM_API_KEY=
MAC_BENCH_LLM_MODEL=
MAC_BENCH_LLM_MAX_RETRIES=0
MAC_BENCH_LLM_TIMEOUT_SECONDS=180

# Modal authentication is configured separately with `modal token new`.
# Optional output destination:
# MAC_BENCH_OUTPUT_ROOT=/path/to/run-storage
